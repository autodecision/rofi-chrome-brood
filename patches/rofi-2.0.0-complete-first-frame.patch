diff --git a/source/rofi-icon-fetcher.c b/source/rofi-icon-fetcher.c
index 8b66600..a20f00c 100644
--- a/source/rofi-icon-fetcher.c
+++ b/source/rofi-icon-fetcher.c
@@ -749,6 +749,20 @@ static void rofi_icon_fetcher_worker(thread_state *sdata,
   rofi_view_reload();
 }
 
+/* Opt-in complete first frame for themes with structural image artwork.
+ * Thumbnail commands remain asynchronous: external tools must not block paint.
+ * No worker for this entry is queued on the synchronous branch.
+ */
+static void rofi_icon_fetcher_queue_or_load(IconFetcherEntry *sentry) {
+  if (g_strcmp0(g_getenv("ROFI_SYNC_THEME_IMAGES"), "1") == 0 &&
+      !g_str_has_prefix(sentry->entry->name, "thumbnail://")) {
+    sentry->query_started = TRUE;
+    rofi_icon_fetcher_worker(&sentry->state, NULL);
+  } else {
+    g_thread_pool_push(tpool, sentry, NULL);
+  }
+}
+
 uint32_t rofi_icon_fetcher_query_advanced(const char *name, const int wsize,
                                           const int hsize) {
   g_debug("Query: %s(%dx%d)", name, wsize, hsize);
@@ -767,7 +781,7 @@ uint32_t rofi_icon_fetcher_query_advanced(const char *name, const int wsize,
     if (sentry->wsize == wsize && sentry->hsize == hsize &&
         sentry->scale == scale) {
       if (!sentry->query_started) {
-        g_thread_pool_push(tpool, sentry, NULL);
+        rofi_icon_fetcher_queue_or_load(sentry);
       }
       return sentry->uid;
     }
@@ -792,7 +806,7 @@ uint32_t rofi_icon_fetcher_query_advanced(const char *name, const int wsize,
   sentry->state.callback = rofi_icon_fetcher_worker;
   sentry->state.free = rofi_icon_fetch_thread_pool_entry_remove;
   sentry->state.priority = G_PRIORITY_LOW;
-  g_thread_pool_push(tpool, sentry, NULL);
+  rofi_icon_fetcher_queue_or_load(sentry);
 
   return sentry->uid;
 }
@@ -813,7 +827,7 @@ uint32_t rofi_icon_fetcher_query(const char *name, const int size) {
     if (sentry->wsize == size && sentry->hsize == size &&
         sentry->scale == scale) {
       if (!sentry->query_started) {
-        g_thread_pool_push(tpool, sentry, NULL);
+        rofi_icon_fetcher_queue_or_load(sentry);
       }
       return sentry->uid;
     }
@@ -838,7 +852,7 @@ uint32_t rofi_icon_fetcher_query(const char *name, const int size) {
   sentry->state.callback = rofi_icon_fetcher_worker;
   sentry->state.free = rofi_icon_fetch_thread_pool_entry_remove;
   sentry->state.priority = G_PRIORITY_LOW;
-  g_thread_pool_push(tpool, sentry, NULL);
